# Writes files into a C++ source as byte arrays, for the shaders the renderer compiles at build time.
#   cmake -DOUTPUT=out.cpp "-DINPUTS=path=symbol|path=symbol" -P embed.cmake
# Each array ends with a 0 that its size leaves out, so a text such as Metal source is also a string.
file(WRITE "${OUTPUT}" "// Generated by port/cmake/embed.cmake.\n#include <cstddef>\n#include <cstdint>\n\nnamespace render::shaders {\n")
string(REPLACE "|" ";" INPUTS "${INPUTS}")
foreach(pair IN LISTS INPUTS)
  string(REPLACE "=" ";" parts "${pair}")
  list(GET parts 0 path)
  list(GET parts 1 symbol)
  file(READ "${path}" hex HEX)
  string(LENGTH "${hex}" digits)
  math(EXPR bytes "${digits} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
  file(APPEND "${OUTPUT}" "extern const uint8_t ${symbol}[] = {${hex}0};\nextern const size_t ${symbol}_size = ${bytes};\n")
endforeach()
file(APPEND "${OUTPUT}" "}  // namespace render::shaders\n")
