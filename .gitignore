# Nothing from a disc, a console or an SDK is ever committed. The config and the symbol table are
# the only products of this work that belong in version control.
game/disc/
game/extracted/
game/dump/
game/cache/
*.chd
*.gdi
*.cdi
*.iso
*.bin
*.BIN
*.vmu
*.vms
*.vmi
/saves/
dc_bios*
dc_boot*
dc_flash*
sdk/
katana/
*.fidb

# Build output
build/
build-*/
.cache/
compile_commands.json

.DS_Store

# Ghidra project, exports and settings: all hold game code
/ghidra/

# Launcher run output: reports, suggested configs, hashes, screenshots
runs/

# Working notes, kept local
docs/progress.md
docs/todo.md

# Claude Code session state
.claude/.cc-writes/

# Katana SDK copies: Sega proprietary
/OFFICIAL KATANA SDKs/
__pycache__/

# Regression gate captures (tools/reference/gate.py)
/.regress/

# Boot ROM and flash images: owner data, supplied like the disc
/bios/

# Decompiled game code (tools/decomp/convert.py): derived from the game, kept in its own
# local repository and never committed here.
/decomp/
/build-port/

# Local build dependencies (SDL3, Ghidra, JDK, libchdr)
/.deps/

# Launcher-prepared discs and extracted files
game/prepared/

# The user's own disc dumps
/ROM/
